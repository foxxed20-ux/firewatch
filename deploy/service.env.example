FIREWATCH_DATA_ROOT=/home/red/firewatch/shared/data/service
FIREWATCH_MODEL_ROOT=/home/red/firewatch/shared/models
FIREWATCH_DOWNLOAD_ROOT=/home/red/firewatch/shared/downloads
FIREWATCH_ARTIFACT_ROOT=/home/red/firewatch/shared/results
FIREWATCH_JOB_DB=/home/red/firewatch/shared/jobs.sqlite3
FIREWATCH_JOB_TIMEOUT_SECONDS=300
FIREWATCH_MAX_WORKERS=1
FIREWATCH_MAX_QUEUED_JOBS=16
FIREWATCH_PUBLIC_DEMO=true
DEVICE=cpu
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
PYTHONUNBUFFERED=1

# Google integration is opt-in. See docs/GOOGLE_CLOUD_SETUP.md.
# This is a browser key: restrict HTTP referrers and Maps JavaScript API in Cloud.
FIREWATCH_GOOGLE_MAPS_API_KEY=
FIREWATCH_GOOGLE_CLOUD_PROJECT=
FIREWATCH_EARTH_ENGINE_ENABLED=false
# Server-only ADC: omit this when the host provides an attached identity.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/earth-engine-service-account.json
FIREWATCH_IMAGERY_MAX_AREA_KM2=10000
FIREWATCH_IMAGERY_MAX_DATE_DAYS=366
FIREWATCH_IMAGERY_TIMEOUT_SECONDS=20
FIREWATCH_IMAGERY_RATE_LIMIT_PER_MINUTE=10
FIREWATCH_IMAGERY_CACHE_SECONDS=300
FIREWATCH_IMAGERY_CACHE_ENTRIES=128
FIREWATCH_IMAGERY_MAX_CONCURRENT=2
